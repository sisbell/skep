            "start": "1.4",
            "width": "0.3"
          }
        ]
      },
      "comment": "equal windows over the two occurrences",
      "result": [
        {
          "window_1": {
            "docid": "1.1.0.1.0.1",
            "span": {
              "start": "1.1",
              "width": "0.3"
