{
  "name": "insert_text",
  "description": "Create document and insert text",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.1",
      "text": "Hello, World!"
    },
    {
      "op": "retrieve_vspanset",
      "doc": "1.1.0.1.0.1",
      "result": {
        "docid": "1.1.0.1.0.1",
        "spans": [
          {
            "start": "1.1",
            "width": "0.13"
          }
        ]
      }
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.1",
      "result": [
        "Hello, World!"
      ]
    },
    {
      "op": "close_document",
      "doc": "1.1.0.1.0.1"
    }
  ]
}