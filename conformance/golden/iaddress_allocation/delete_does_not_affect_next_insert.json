          "spans": [
            {
              "start": "1.1",
              "width": "0.1"
            }
          ]
        }
      }
    },
    {
      "op": "insert_C",
      "result": {
        "content": [
          "BC"
        ],
        "vspans": {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.2"
            }
          ]
        }
      }
    },
    {
      "op": "compare_via_transclusion",
      "result": {
        "shared_span_pairs": 1,
        "shared": [
          {
            "doc1": {
              "start": "1.1",
              "width": "0.2"
            },
            "doc2": {
              "start": "1.1",
              "width": "0.2"
            }
