      "op": "insert",
      "text": "ABCDEFGH"
    },
    {
      "op": "create_link",
      "source_text": "CD",
      "result": "1.1.0.1.0.1.0.2.1"
    },
    {
      "op": "retrieve_endsets",
      "label": "before",
      "source": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.3",
              "width": "0.2"
            }
          ]
        }
      ]
    },
    {
      "op": "content",
      "before": [
        "ABCDEFGH"
      ]
    },
    {
      "op": "pivot",
