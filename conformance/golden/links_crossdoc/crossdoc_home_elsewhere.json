{
  "name": "crossdoc_home_elsewhere",
  "description": "Link homed in a third document that appears in no endset; homedocids filter probed",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1",
      "doc_label": "A"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "conflict": "fail",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.1",
      "text": "origin text"
    },
    {
      "op": "create_document",
      "result": "1.1.0.1.0.2",
      "doc_label": "B"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.2",
      "mode": "read_write",
      "conflict": "fail",
      "result": "1.1.0.1.0.2"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.2",
      "address": "1.1",
      "text": "destination"
    },
    {
      "op": "create_document",
      "result": "1.1.0.1.0.3",
      "doc_label": "H"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.3",
      "mode": "read_write",
      "conflict": "fail",
      "result": "1.1.0.1.0.3"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.3",
      "address": "1.1",
      "text": "home shelf"
    },
    {
      "op": "create_link",
      "home": "1.1.0.1.0.3",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "toset": [
        {
          "docid": "1.1.0.1.0.2",
          "spans": [
            {
              "start": "1.1",
              "width": "0.11"
            }
          ]
        }
      ],
      "threeset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.0.2.2",
              "width": "0.1"
            }
          ]
        }
      ],
      "comment": "home doc H not in any endset",
      "result": "1.1.0.1.0.3.0.2.1"
    },
    {
      "op": "probe",
      "doc": "1.1.0.1.0.1",
      "doc_label": "A",
      "vspanset": [
        {
          "start": "1.1",
          "width": "0.11"
        }
      ],
      "contents": [
        "origin text"
      ]
    },
    {
      "op": "probe",
      "doc": "1.1.0.1.0.2",
      "doc_label": "B",
      "vspanset": [
        {
          "start": "1.1",
          "width": "0.11"
        }
      ],
      "contents": [
        "destination"
      ]
    },
    {
      "op": "probe",
      "doc": "1.1.0.1.0.3",
      "doc_label": "H",
      "comment": "home doc should hold the link entry",
      "vspanset": [
        {
          "start": "0",
          "width": "0.1"
        },
        {
          "start": "1",
          "width": "1"
        }
      ],
      "contents": [
        "home shelf"
      ]
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.3",
      "span": {
        "start": "2.1",
        "width": "0.1"
      },
      "doc_label": "H",
      "comment": "link as content at H local 2.1",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    },
    {
      "op": "follow_link",
      "link": "1.1.0.1.0.3.0.2.1",
      "end": "from",
      "result": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ]
    },
    {
      "op": "follow_link",
      "link": "1.1.0.1.0.3.0.2.1",
      "end": "to",
      "result": [
        {
          "docid": "1.1.0.1.0.2",
          "spans": [
            {
              "start": "1.1",
              "width": "0.11"
            }
          ]
        }
      ]
    },
    {
      "op": "follow_link",
      "link": "1.1.0.1.0.3.0.2.1",
      "end": "three",
      "error": "request failed (?)"
    },
    {
      "op": "find_links",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "comment": "no home filter",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    },
    {
      "note": "client.find_links serializes homedocids as bare addresses; the backend parses the home set as a spanset of (start, width) pairs (get2fe.c getspanset), so a non-empty homedocids list from the stock client hangs the session. The probes below serialize the home set as spans."
    },
    {
      "op": "find_links_homespans",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "toset": [],
      "threeset": [],
      "homespans": [
        {
          "start": "1.1.0.1.0.3",
          "width": "0.0.0.0.0.1"
        }
      ],
      "comment": "home span covering H (the true home)",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    },
    {
      "op": "find_links_homespans",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "toset": [],
      "threeset": [],
      "homespans": [
        {
          "start": "1.1.0.1.0.1",
          "width": "0.0.0.0.0.1"
        }
      ],
      "comment": "home span covering A (not the home) - filter honored?",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    },
    {
      "op": "find_links_homespans",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "toset": [],
      "threeset": [],
      "homespans": [
        {
          "start": "1.1.0.1.0.2",
          "width": "0.0.0.0.0.1"
        }
      ],
      "comment": "home span covering B (not the home)",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    },
    {
      "op": "find_links_homespans",
      "fromset": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "toset": [],
      "threeset": [],
      "homespans": [
        {
          "start": "1.1.0.1.0.3",
          "width": "0.1"
        }
      ],
      "comment": "degenerate short width 0.1 on H",
      "result": [
        "1.1.0.1.0.3.0.2.1"
      ]
    }
  ]
}