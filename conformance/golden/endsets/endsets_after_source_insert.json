{
  "name": "endsets_after_source_insert",
  "description": "Retrieve endsets after inserting text into linked source region",
  "operations": [
    {
      "op": "create_link",
      "source_text": "here",
      "result": "1.1.0.1.0.1.0.2.1"
    },
    {
      "op": "retrieve_endsets",
      "label": "before",
      "source": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.7",
              "width": "0.4"
            }
          ]
        }
      ],
      "target": []
    },
    {
      "op": "insert",
      "doc": "source",
      "address": "1.7",
      "text": "right ",
      "comment": "Insert inside link source span"
    },
    {
      "op": "retrieve_endsets",
      "label": "after",
      "source": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.13",
              "width": "0.4"
            }
          ]
        }
      ],
      "target": [],
      "comment": "Has source span width changed?"
    },
    {
      "op": "content",
      "result": [
        "Click right here for info"
      ]
    }
  ]
}