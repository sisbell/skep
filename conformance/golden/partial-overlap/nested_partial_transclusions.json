      "result": "1.1.0.1.0.1.0.2.1"
    },
    {
      "op": "create_document",
      "doc": "level1",
      "result": "1.1.0.1.0.3"
    },
    {
      "op": "vcopy",
      "from": "origin",
      "to": "level1",
      "text": "DEFGHIJKLM"
    },
    {
      "op": "create_document",
      "doc": "level2",
      "result": "1.1.0.1.0.4"
    },
    {
