      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert_A",
      "result": {
        "content": [
          "A"
        ],
        "vspans": {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.1"
            }
          ]
        }
      }
    },
    {
      "op": "insert_B",
      "result": {
        "content": [
          "AB"
        ],
        "vspans": {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.2"
            }
          ]
        }
      }
    },
    {
      "op": "delete_A",
      "result": {
        "content": [
          "B"
        ],
        "vspans": {
