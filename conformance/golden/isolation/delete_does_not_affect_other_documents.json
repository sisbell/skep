{
  "name": "delete_does_not_affect_other_documents",
  "description": "DELETE in doc A does not modify doc B",
  "operations": [
    {
      "op": "setup",
      "docs": {
        "A": "1.1.0.1.0.1",
        "B": "1.1.0.1.0.2"
      }
    },
    {
      "op": "snapshot",
      "doc": "B",
      "label": "before_A_delete",
      "content": [
        "1234567890"
      ]
    },
    {
      "op": "remove",
      "doc": "A",
      "span": "1.3 for 0.5 (CDEFG)"
    },
    {
      "op": "contents",
      "doc": "A",
      "label": "after_delete",
      "result": [
        "ABHIJ"
      ]
    },
    {
      "op": "snapshot",
      "doc": "B",
      "label": "after_A_delete",
      "content": [
        "1234567890"
      ]
    },
    {
      "op": "verify",
      "assertion": "B unchanged",
      "match": true
    }
  ]
}