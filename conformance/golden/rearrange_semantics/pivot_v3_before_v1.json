{
  "name": "pivot_v3_before_v1",
  "description": "Pivot where v\u2083 < v\u2081 (move content earlier)",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "address": "1.1",
      "text": "ABCDEFGH"
    },
    {
      "op": "retrieve",
      "before": [
        "ABCDEFGH"
      ]
    },
    {
      "op": "vspanset_before",
      "result": "<VSpec in 1.1.0.1.0.1, at 1.1 for 0.8>"
    },
    {
      "op": "pivot",
      "v1": "1.4",
      "v2": "1.6",
      "v3": "1.2",
      "description": "Move DE from [1.4,1.6) to 1.2"
    },
    {
      "op": "retrieve",
      "after": [
        "ABCDEFGH"
      ]
    },
    {
      "op": "vspanset_after",
      "result": "<VSpec in 1.1.0.1.0.1, at 1.1 for 0.8>",
      "comment": "Check if I-addresses preserved and V-addresses changed"
    }
  ]
}