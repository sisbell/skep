      "address": "1.1",
      "text": "XYZ"
    },
    {
      "op": "vcopy",
      "dest": "1.1.0.1.0.1",
      "at": "1.4",
      "source": {
        "docid": "1.1.0.1.0.1",
        "span": {
          "start": "1.1",
          "width": "0.3"
        }
      },
      "comment": "doc copies its own 1.1-1.3 to 1.4"
    },
    {
      "op": "probe",
      "doc": "1.1.0.1.0.1",
      "doc_label": "doc",
      "vspanset": [
