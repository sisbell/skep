{
  "name": "find_documents_basic",
  "description": "Find a document by searching its own content",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "text": "Hello World"
    },
    {
      "op": "find_documents",
      "search": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.11"
            }
          ]
        }
      ],
      "result": [
        "1.1.0.1.0.1"
      ],
      "comment": "Should find the document itself"
    }
  ]
}