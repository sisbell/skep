{
  "name": "fanout_self_repetition",
  "description": "Internal repetition via self-vcopy; self-compares over equal and identical windows",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1",
      "doc_label": "doc"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
