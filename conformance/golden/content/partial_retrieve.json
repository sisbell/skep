{
  "name": "partial_retrieve",
  "description": "Retrieve only a portion of document content",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.1",
      "text": "The quick brown fox jumps over the lazy dog"
    },
    {
      "op": "retrieve_vspanset",
      "doc": "1.1.0.1.0.1",
      "result": {
        "docid": "1.1.0.1.0.1",
        "spans": [
          {
            "start": "1.1",
            "width": "0.43"
          }
        ]
      }
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.1",
      "span": {
        "start": "1.5",
        "width": "0.11"
      },
      "result": [
        "quick brown"
      ]
    },
    {
      "op": "close_document",
      "doc": "1.1.0.1.0.1"
    }
  ]
}