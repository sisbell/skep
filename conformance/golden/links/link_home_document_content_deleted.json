{
  "name": "link_home_document_content_deleted",
  "description": "Test what happens when the link's HOME document content is deleted",
  "operations": [
    {
      "op": "create_document",
      "doc": "home",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "home",
      "text": "Home document stores the link"
    },
    {
      "op": "create_document",
      "doc": "source",
      "result": "1.1.0.1.0.2"
    },
    {
      "op": "insert",
      "doc": "source",
      "text": "Source document content"
    },
    {
      "op": "create_document",
      "doc": "target",
      "result": "1.1.0.1.0.3"
    },
    {
      "op": "insert",
      "doc": "target",
      "text": "Target document content"
    },
    {
      "op": "create_link",
      "home_doc": "1.1.0.1.0.1",
      "source_text": "Source",
      "target_text": "Target",
      "result": "1.1.0.1.0.1.0.2.1",
      "comment": "Link stored in home document, spans source and target"
    },
    {
      "op": "follow_link",
      "label": "before_delete",
      "end": "source",
      "result": [
        "Source"
      ]
    },
    {
      "op": "follow_link",
      "label": "before_delete",
      "end": "target",
      "result": [
        "Target"
      ]
    },
    {
      "op": "find_links",
      "label": "before_delete",
      "result": [
        "1.1.0.1.0.1.0.2.1"
      ]
    },
    {
      "op": "delete_all",
      "doc": "home",
      "comment": "Delete ALL content from home document where link is stored"
    },
    {
      "op": "vspanset",
      "doc": "home",
      "spans": [
        {
          "start": "2.1",
          "width": "0.1"
        }
      ]
    },
    {
      "op": "find_links",
      "label": "after_delete",
      "result": [
        "1.1.0.1.0.1.0.2.1"
      ],
      "comment": "Can link still be found from source?"
    },
    {
      "op": "follow_link",
      "label": "after_delete",
      "end": "source",
      "result": [
        "Source"
      ],
      "works": true,
      "comment": "Can link still be followed?"
    },
    {
      "op": "follow_link",
      "label": "after_delete",
      "end": "target",
      "result": [
        "Target"
      ],
      "comment": "Does target still work?"
    }
  ]
}