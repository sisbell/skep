{
  "name": "reopen_document",
  "description": "Close and reopen a document, verifying content persists",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.1",
      "text": "Persistent content"
    },
    {
      "op": "close_document",
      "doc": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "result": "1.1.0.1.0.1",
      "comment": "Reopen same document"
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.1",
      "result": [
        "Persistent content"
      ],
      "comment": "Content persisted across close/open"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.19",
      "text": " with additions"
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.1",
      "result": [
        "Persistent content with additions"
      ]
    },
    {
      "op": "close_document",
      "doc": "1.1.0.1.0.1"
    }
  ]
}