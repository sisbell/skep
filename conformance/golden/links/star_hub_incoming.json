{
  "name": "star_hub_incoming",
  "description": "Test star/hub pattern: 3 peripherals all link TO central hub",
  "operations": [
    {
      "op": "create_document",
      "doc": "hub",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "hub",
      "text": "Central Hub: all roads lead here"
    },
    {
      "op": "create_documents",
      "doc": "peripherals",
      "count": 3,
      "results": [
        "1.1.0.1.0.2",
        "1.1.0.1.0.3",
        "1.1.0.1.0.4"
      ]
    },
    {
      "op": "create_links",
      "from": "peripherals",
      "to": "hub",
      "results": [
        "1.1.0.1.0.2.0.2.1",
        "1.1.0.1.0.3.0.2.1",
        "1.1.0.1.0.4.0.2.1"
      ]
    },
    {
      "op": "find_links",
      "to": "hub",
      "result": [
        "1.1.0.1.0.2.0.2.1",
        "1.1.0.1.0.3.0.2.1",
        "1.1.0.1.0.4.0.2.1"
      ],
      "expected_count": 3,
      "comment": "Should find all 3 links pointing to hub"
    },
    {
      "op": "follow_links_to_sources",
      "results": [
        {
          "link": "1.1.0.1.0.2.0.2.1",
          "source_text": [
            "link to hub"
          ]
        },
        {
          "link": "1.1.0.1.0.3.0.2.1",
          "source_text": [
            "link to hub"
          ]
        },
        {
          "link": "1.1.0.1.0.4.0.2.1",
          "source_text": [
            "link to hub"
          ]
        }
      ],
      "comment": "Each link source should be a different peripheral"
    }
  ]
}