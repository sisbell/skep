    {
      "op": "content",
      "after": [
        "ADEBCFGH"
      ]
    },
    {
      "op": "retrieve_endsets",
      "label": "after",
      "source": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.2",
              "width": "0.1"
            },
            {
              "start": "1.2",
              "width": "0.1"
            },
            {
              "start": "1.5",
              "width": "0.1"
            },
            {
              "start": "1.5",
              "width": "0.1"
            }
          ]
        }
      ],
      "comment": "Do endsets track the rearranged content?"
    },
    {
      "op": "find_links",
      "result": [
        "1.1.0.1.0.1.0.2.1",
        "1.1.0.1.0.1.0.2.1"
