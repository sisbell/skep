{
  "name": "text_insert_preserves_link_vpositions",
  "description": "Test whether text insertion in 1.x affects link positions in 2.x",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "mode": "read_write",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.1",
      "text": "HelloWorld",
      "note": "Initial 10 chars"
    },
    {
      "op": "retrieve_vspanset",
      "doc": "1.1.0.1.0.1",
      "result": {
        "docid": "1.1.0.1.0.1",
        "spans": [
          {
            "start": "1.1",
            "width": "0.10"
          }
        ]
      },
      "note": "Before link: should show 1.x only"
    },
    {
      "op": "create_document",
      "result": "1.1.0.1.0.2"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.2",
      "mode": "read_write",
      "result": "1.1.0.1.0.2"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.2",
      "address": "1.1",
      "text": "Target"
    },
    {
      "op": "create_link",
      "home_doc": "1.1.0.1.0.1",
      "source": [
        {
          "docid": "1.1.0.1.0.1",
          "spans": [
            {
              "start": "1.1",
              "width": "0.5"
            }
          ]
        }
      ],
      "target": [
        {
          "docid": "1.1.0.1.0.2",
          "spans": [
            {
              "start": "1.1",
              "width": "0.6"
            }
          ]
        }
      ],
      "type": "jump",
      "result": "1.1.0.1.0.1.0.2.1",
      "note": "Link should be at 2.1"
    },
    {
      "op": "retrieve_vspanset",
      "doc": "1.1.0.1.0.1",
      "result": {
        "docid": "1.1.0.1.0.1",
        "spans": [
          {
            "start": "0",
            "width": "0.1"
          },
          {
            "start": "1",
            "width": "1"
          }
        ]
      },
      "note": "After link: should show 1.x and 2.x"
    },
    {
      "op": "insert",
      "doc": "1.1.0.1.0.1",
      "address": "1.5",
      "text": "XXXXX",
      "note": "Insert 5 chars at middle of text"
    },
    {
      "op": "retrieve_vspanset",
      "doc": "1.1.0.1.0.1",
      "result": {
        "docid": "1.1.0.1.0.1",
        "spans": [
          {
            "start": "0",
            "width": "0.10"
          },
          {
            "start": "1",
            "width": "1"
          }
        ]
      },
      "note": "After insert: text should be 1.15, link position?"
    },
    {
      "op": "retrieve_contents",
      "doc": "1.1.0.1.0.1",
      "result": [
        "HellXXXXXoWorld"
      ],
      "note": "Final text should be 'HelloXXXXXWorld'"
    }
  ]
}