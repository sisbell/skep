      "op": "contents",
      "doc": "level1",
      "result": [
        "DEFGHIJKLM"
      ]
    },
    {
      "op": "contents",
      "doc": "level2",
      "result": [
        "GHIJ"
      ]
    },
    {
      "op": "find_links",
      "from": "origin",
      "result": [
        "1.1.0.1.0.1.0.2.1"
      ]
    },
    {
      "op": "find_links",
      "from": "level1",
      "result": [
        "1.1.0.1.0.1.0.2.1"
      ],
      "comment": "Level1 has FGHIJK (full link source)"
    },
    {
      "op": "find_links",
      "from": "level2",
      "result": [
        "1.1.0.1.0.1.0.2.1"
      ],
      "comment": "Level2 has GHIJ (partial overlap with FGHIJK)"
    },
    {
      "op": "follow_link",
      "from": "origin",
      "result": [
        "FGHIJK"
      ],
      "comment": "Full link source FGHIJK"
    },
    {
      "op": "follow_link",
