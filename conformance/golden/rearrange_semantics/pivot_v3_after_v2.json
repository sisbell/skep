{
  "name": "pivot_v3_after_v2",
  "description": "Pivot where v\u2083 > v\u2082 (move content later)",
  "operations": [
    {
      "op": "create_document",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "open_document",
      "doc": "1.1.0.1.0.1",
      "result": "1.1.0.1.0.1"
    },
    {
      "op": "insert",
      "address": "1.1",
      "text": "ABCDEFGH"
    },
    {
      "op": "retrieve",
      "before": [
        "ABCDEFGH"
      ]
    },
    {
